# --- Qwen via DashScope (endpoint OpenAI-compatible) ---
# Get your key at https://bailian.console.alibabacloud.com/ (DashScope API-KEY)
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-dashscope-key
QWEN_MODEL=qwen-plus

# --- PostgreSQL + pgvector (docker-compose.yml) ---
DATABASE_URL=postgresql://tutor:tutor@localhost:15432/algo_tutor

# --- Embeddings ---
# bge-m3 (BAAI/bge-m3) -> 1024 dims, downloaded locally on first ingestion (~2 GB)
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# --- Sandbox ---
SANDBOX_TIMEOUT_SECONDS=3
SANDBOX_MEMORY_LIMIT=128m
SANDBOX_CPU_LIMIT=1.0
